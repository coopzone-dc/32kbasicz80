0010   0000             ;
0011   0000             ; If the above don't work, please perform an Internet search to see if I have
0012   0000             ; updated the web page hosting service.
0013   0000             ;
0014   0000             ; Phil_G: Small monitor added, just fits in an 8k rom above basic.  
0015   0000             ;
0016   0000             ;==================================================================================
0017   0000             
0018   0000             ; Minimum 6850 ACIA interrupt driven serial I/O to run modified NASCOM Basic 4.7
0019   0000             ; Full input buffering with incoming data hardware handshaking
0020   0000             ; Handshake shows full before the buffer is totally filled to allow run-on from the sender
0021   0000             
0022   0000             SER_BUFSIZE     .EQU     3FH
0023   0000             SER_FULLSIZE    .EQU     30H
0024   0000             SER_EMPTYSIZE   .EQU     5
0025   0000             
0026   0000             RTS_HIGH        .EQU     0D6H
0027   0000             RTS_LOW         .EQU     096H
0028   0000             
0029   0000             serBuf          .EQU     $8000
0030   0000             serInPtr        .EQU     serBuf+SER_BUFSIZE
0031   0000             serRdPtr        .EQU     serInPtr+2
0032   0000             serBufUsed      .EQU     serRdPtr+2
0033   0000             basicStarted    .EQU     serBufUsed+1
0034   0000             TEMPSTACK       .EQU     $80ED	; Top of BASIC line input buffer so is "free ram" when BASIC resets
0035   0000             MONITOR		.EQU	 $1DC0	; M/C monitor program just above BASIC
0036   0000             
0037   0000             CR              .EQU     0DH
0038   0000             LF              .EQU     0AH
0039   0000             CS              .EQU     0CH             ; Clear screen
0040   0000             
0041   0000                             .ORG $0000
0042   0000             ;------------------------------------------------------------------------------
0043   0000             ; Reset
0044   0000             
0045   0000 F3          RST00           DI                       ;Disable interrupts
0046   0001 C3 B8 00                    JP       INIT            ;Initialize Hardware and go
0047   0004             
0048   0004             ;------------------------------------------------------------------------------
0049   0004             ; TX a character over RS232 
0050   0004             
0051   0008                             .ORG     0008H
0052   0008 C3 9F 00    RST08            JP      TXA
0053   000B             
0054   000B             ;------------------------------------------------------------------------------
0055   000B             ; RX a character over RS232 Channel A [Console], hold here until char ready.
0056   000B             
0057   0010                             .ORG 0010H
0058   0010 C3 74 00    RST10            JP      RXA
0059   0013             
0060   0013             ;------------------------------------------------------------------------------
0061   0013             ; Check serial status
0062   0013             
0063   0018                             .ORG 0018H
0064   0018 C3 AA 00    RST18            JP      CKINCHAR
0065   001B             
0066   001B             ;------------------------------------------------------------------------------
0067   001B             ; RST 38 - INTERRUPT VECTOR [ for IM 1 ]
0068   001B             
0069   0038                             .ORG     0038H
0070   0038 18 00       RST38            JR      serialInt       
0071   003A             
0072   003A             ;------------------------------------------------------------------------------
0073   003A F5          serialInt:      PUSH     AF
0074   003B E5                          PUSH     HL
0075   003C             
0076   003C DB 80                       IN       A,($80)
0077   003E E6 01                       AND      $01             ; Check if interupt due to read buffer full
0078   0040 28 2D                       JR       Z,rts0          ; if not, ignore
0079   0042             
0080   0042 DB 81                       IN       A,($81)
0081   0044 F5                          PUSH     AF
0082   0045 3A 43 80                    LD       A,(serBufUsed)
0083   0048 FE 3F                       CP       SER_BUFSIZE     ; If full then ignore
0084   004A 20 03                       JR       NZ,notFull
0085   004C F1                          POP      AF
0086   004D 18 20                       JR       rts0
0087   004F             
0088   004F 2A 3F 80    notFull:        LD       HL,(serInPtr)
0089   0052 23                          INC      HL
0090   0053 7D                          LD       A,L             ; Only need to check low byte becasuse buffer<256 bytes
0091   0054 FE 3F                       CP       (serBuf+SER_BUFSIZE) & $FF
0092   0056 20 03                       JR       NZ, notWrap
0093   0058 21 00 80                    LD       HL,serBuf
0094   005B 22 3F 80    notWrap:        LD       (serInPtr),HL
0095   005E F1                          POP      AF
0096   005F 77                          LD       (HL),A
0097   0060 3A 43 80                    LD       A,(serBufUsed)
0098   0063 3C                          INC      A
0099   0064 32 43 80                    LD       (serBufUsed),A
0100   0067 FE 30                       CP       SER_FULLSIZE
0101   0069 38 04                       JR       C,rts0
0102   006B 3E D6                       LD       A,RTS_HIGH
0103   006D D3 80                       OUT      ($80),A
0104   006F E1          rts0:           POP      HL
0105   0070 F1                          POP      AF
0106   0071 FB                          EI
0107   0072 ED 4D                       RETI
0108   0074             
0109   0074             ;------------------------------------------------------------------------------
0110   0074             RXA:
0111   0074 3A 43 80    waitForChar:    LD       A,(serBufUsed)
0112   0077 FE 00                       CP       $00
0113   0079 28 F9                       JR       Z, waitForChar
0114   007B E5                          PUSH     HL
0115   007C 2A 41 80                    LD       HL,(serRdPtr)
0116   007F 23                          INC      HL
0117   0080 7D                          LD       A,L             ; Only need to check low byte becasuse buffer<256 bytes
0118   0081 FE 3F                       CP       (serBuf+SER_BUFSIZE) & $FF
0119   0083 20 03                       JR       NZ, notRdWrap
0120   0085 21 00 80                    LD       HL,serBuf
0121   0088 F3          notRdWrap:      DI
0122   0089 22 41 80                    LD       (serRdPtr),HL
0123   008C 3A 43 80                    LD       A,(serBufUsed)
0124   008F 3D                          DEC      A
0125   0090 32 43 80                    LD       (serBufUsed),A
0126   0093 FE 05                       CP       SER_EMPTYSIZE
0127   0095 30 04                       JR       NC,rts1
0128   0097 3E 96                       LD       A,RTS_LOW
0129   0099 D3 80                       OUT      ($80),A
0130   009B             rts1:
0131   009B 7E                          LD       A,(HL)
0132   009C FB                          EI
0133   009D E1                          POP      HL
0134   009E C9                          RET                      ; Char ready in A
0135   009F             
0136   009F             ;------------------------------------------------------------------------------
0137   009F F5          TXA:            PUSH     AF              ; Store character
0138   00A0 DB 80       conout1:        IN       A,($80)         ; Status byte       
0139   00A2 CB 4F                       BIT      1,A             ; Set Zero flag if still transmitting character       
0140   00A4 28 FA                       JR       Z,conout1       ; Loop until flag signals ready
0141   00A6 F1                          POP      AF              ; Retrieve character
0142   00A7 D3 81                       OUT      ($81),A         ; Output the character
0143   00A9 C9                          RET
0144   00AA             
0145   00AA             ;------------------------------------------------------------------------------
0146   00AA 3A 43 80    CKINCHAR        LD       A,(serBufUsed)
0147   00AD FE 00                       CP       $0
0148   00AF C9                          RET
0149   00B0             
0150   00B0 7E          PRINT:          LD       A,(HL)          ; Get character
0151   00B1 B7                          OR       A               ; Is it $00 ?
0152   00B2 C8                          RET      Z               ; Then RETurn on terminator
0153   00B3 CF                          RST      08H             ; Print it
0154   00B4 23                          INC      HL              ; Next Character
0155   00B5 18 F9                       JR       PRINT           ; Continue until $00
0156   00B7 C9                          RET
0157   00B8             ;------------------------------------------------------------------------------
0158   00B8             INIT:
0159   00B8 21 ED 80                   LD        HL,TEMPSTACK    ; Temp stack
0160   00BB F9                         LD        SP,HL           ; Set up a temporary stack
0161   00BC 21 00 80                   LD        HL,serBuf
0162   00BF 22 3F 80                   LD        (serInPtr),HL
0163   00C2 22 41 80                   LD        (serRdPtr),HL
0164   00C5 AF                         XOR       A               ;0 to accumulator
0165   00C6 32 43 80                   LD        (serBufUsed),A
0166   00C9 3E 96                      LD        A,RTS_LOW
0167   00CB D3 80                      OUT       ($80),A         ; Initialise ACIA
0168   00CD ED 56                      IM        1
0169   00CF FB                         EI
0170   00D0 21 0E 01                   LD        HL,SIGNON1      ; Sign-on message
0171   00D3 CD B0 00                   CALL      PRINT           ; Output string
0172   00D6 3A 44 80                   LD        A,(basicStarted); Check the BASIC STARTED flag
0173   00D9 FE 59                      CP        'Y'             ; to see if this is power-up
0174   00DB 20 1B                      JR        NZ,COLDSTART    ; If not BASIC started then always do cold start
0175   00DD 21 26 01                   LD        HL,SIGNON2      ; Cold/warm message
0176   00E0 CD B0 00                   CALL      PRINT           ; Output string
0177   00E3             CORW:
0178   00E3 CD 74 00                   CALL      RXA
0179   00E6 E6 DF                      AND       %11011111       ; lower to uppercase
0180   00E8 FE 4D       	       CP	 'M'
0181   00EA CA C0 1D    	       JP	 Z,MONITOR
0182   00ED FE 43                      CP        'C'
0183   00EF 20 0F                      JR        NZ, CHECKWARM
0184   00F1 CF                         RST       08H
0185   00F2 3E 0D                      LD        A,$0D
0186   00F4 CF                         RST       08H
0187   00F5 3E 0A                      LD        A,$0A
0188   00F7 CF                         RST       08H
0189   00F8 3E 59       COLDSTART:     LD        A,'Y'           ; Set the BASIC STARTED flag
0190   00FA 32 44 80                   LD        (basicStarted),A
0191   00FD C3 50 01                   JP        $0150           ; Start BASIC COLD
0192   0100             CHECKWARM:
0193   0100 FE 57                      CP        'W'
0194   0102 20 DF                      JR        NZ, CORW
0195   0104 CF                         RST       08H
0196   0105 3E 0D                      LD        A,$0D
0197   0107 CF                         RST       08H
0198   0108 3E 0A                      LD        A,$0A
0199   010A CF                         RST       08H
0200   010B C3 53 01                   JP        $0153           ; Start BASIC WARM
0201   010E                           
0202   010E 0D 0A       SIGNON1:       .BYTE     CR,LF
0203   0110 47 20 53 65                .BYTE     "G Searle 32k Z80SBC",CR,LF,0
0203   0114 61 72 6C 65 
0203   0118 20 33 32 6B 
0203   011C 20 5A 38 30 
0203   0120 53 42 43 0D 
0203   0124 0A 00 
0204   0126 0D 0A       SIGNON2:       .BYTE     CR,LF
0205   0128             ;              .BYTE     "Cold or warm start (C or W)? ",0
0206   0128 3C 43 3E 6F                .BYTE     "<C>old, <W>arm or <M>onitor? ",0
0206   012C 6C 64 2C 20 
0206   0130 3C 57 3E 61 
0206   0134 72 6D 20 6F 
0206   0138 72 20 3C 4D 
0206   013C 3E 6F 6E 69 
0206   0140 74 6F 72 3F 
0206   0144 20 00 
0207   0146                           
0208   0146             .END
tasm: Number of errors = 0
