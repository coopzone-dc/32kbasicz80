   988                             ;; create fd table
   989                             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   990                          
   991                             ; __clib_open_max  = max number of open fds specified by user
   992                             ; 0 = number of static file descriptors created
   993                          
   994                             PUBLIC __fcntl_fdtbl
   995                             PUBLIC __fcntl_fdtbl_size
   996                          
   997                             IF 0 > 0
   998                          
   999                                ; create rest of fd table in data segment
  1000                          
  1001                                SECTION data_fcntl_fdtable_body
  1002                          
  1003                                EXTERN __data_fcntl_fdtable_body_head
  1004                          
  1005                                defc __fcntl_fdtbl = __data_fcntl_fdtable_body_head
  1006                          
  1007                                IF __clib_open_max > 0
  1008                          
  1009                                   SECTION data_fcntl_fdtable_body
  1010                          
  1011                                   defs (__clib_open_max - 0) * 2
  1012                                   defc __fcntl_fdtbl_size = __clib_open_max
  1013                          
  1014                                ELSE
  1015                          
  1016                                   defc __fcntl_fdtbl_size = 0
  1017                          
  1018                                ENDIF
  1019                          
  1020                             ELSE
  1021                          
  1022                                IF __clib_open_max > 0
  1023                          
  1024                                   ; create fd table in bss segment
  1025                          
  1026                                   SECTION bss_clib
  1027                                   SECTION bss_fcntl
  1028                          
  1029                                   __fcntl_fdtbl:        defs __clib_open_max * 2
  1030                          
  1031                                ELSE
  1032                          
  1033                                   ; no fd table at all
  1034                          
  1035                                   defc __fcntl_fdtbl = 0
  1036                          
  1037                                ENDIF
  1038                          
  1039                                defc __fcntl_fdtbl_size = __clib_open_max
  1040                          
  1041                             ENDIF
  1042                          
  1043                          	PUBLIC __MAX_OPEN
  1044                          	defc   __MAX_OPEN = __fcntl_fdtbl_size
  1045                          
  1046                             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1047                             ;; finalize stdio heap
  1048                             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  1049                          
  1050                             ; __clib_stdio_heap_size  = desired stdio heap size in bytes
  1051                             ; 0  = byte size of static FDSTRUCTs
  1052                             ; 0   = number of heap allocations
  1053                             ; __i_fcntl_heap_n     = address of allocation #n on heap (0..__I_FCNTL_NUM_HEAP-1)
  1054                          
  1055                             IF 0 > 0
  1056                          
  1057                                ; static FDSTRUCTs have been allocated in the heap
  1058                          
  1059                                SECTION data_clib
  1060                                SECTION data_fcntl
  1061                          
  1062                                PUBLIC __stdio_heap
  1063                          
  1064                                __stdio_heap:            defw __stdio_block
  1065                          
  1066                                SECTION data_fcntl_stdio_heap_head
  1067                          
  1068                                __stdio_block:
  1069                          
  1070                                   defb 0                ; no owner
  1071                                   defb 0x01             ; mtx_plain
  1072                                   defb 0                ; number of lock acquisitions
  1073                                   defb 0xfe             ; spinlock (unlocked)
  1074                                   defw 0                ; list of threads blocked on mutex
  1075                          
  1076                                IF __clib_stdio_heap_size > (0 + 14)
  1077                          
  1078                                   ; expand stdio heap to desired size
  1079                          
  1080                                   SECTION data_fcntl_stdio_heap_body
  1081                          
  1082                                   __i_fcntl_heap_0:
  1083                          
  1084                                      defw __i_fcntl_heap_1
  1085                                      defw 0
  1086                                      defw __i_fcntl_heap_-1
  1087                                      defs __clib_stdio_heap_size - 0 - 14
  1088                          
  1089                                   ; terminate stdio heap
  1090                          
  1091                                   SECTION data_fcntl_stdio_heap_tail
  1092                          
  1093                                   __i_fcntl_heap_1:   defw 0
  1094                          
  1095                                ELSE
  1096                          
  1097                                   ; terminate stdio heap
  1098                          
  1099                                   SECTION data_fcntl_stdio_heap_tail
  1100                          
  1101                                   __i_fcntl_heap_0:   defw 0
  1102                          
  1103                                ENDIF
  1104                          
  1105                             ELSE
  1106                          
  1107                                ; no FDSTRUCTs statically created
  1108                          
  1109                                IF __clib_stdio_heap_size > 14
  1110                          
  1111                                   SECTION data_clib
  1112                                   SECTION data_fcntl
  1113                          
  1114                                   PUBLIC __stdio_heap
  1115                          
  1116  0000  0000                       __stdio_heap:         defw __stdio_block
  1117                          
  1118                                   SECTION bss_clib
  1119                                   SECTION bss_fcntl
  1120                          
  1121                                   PUBLIC __stdio_block
  1122                          
  1123  0000  0000000000000000           __stdio_block:         defs __clib_stdio_heap_size
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
  1124                          
  1125                                   SECTION code_crt_init
  1126                          
  1127  0000  210000                     ld hl,__stdio_block
  1128  0003  010000                     ld bc,__clib_stdio_heap_size
  1129                          
  1130                                   EXTERN asm_heap_init
  1131  0006  cd0000                     call asm_heap_init
  1132                          
  1133                                ENDIF
  1134                          
  1135                             ENDIF
