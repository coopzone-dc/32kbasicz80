   843                          ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   844                          ;; INSTANTIATE DRIVERS ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   845                          ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   846                          
   847                          ; The embedded target has no device drivers so it cannot
   848                          ; instantiate FILEs.
   849                          
   850                          ; It can use sprint/sscanf + family and it can create
   851                          ; memstreams in the default configuration.
   852                          
   853                          
   854                          ; When FILEs and FDSTRUCTs are instantiated labels are assigned
   855                          ; to point at created structures.
   856                          ;
   857                          ; The label formats are:
   858                          ;
   859                          ; __i_stdio_file_n     = address of static FILE structure #n (0..__I_STDIO_NUM_FILE-1)
   860                          ; __i_fcntl_fdstruct_n = address of static FDSTRUCT #n (0..__I_FCNTL_NUM_FD-1)
   861                          ; __i_fcntl_heap_n     = address of allocation #n on heap (0..__I_FCNTL_NUM_HEAP-1)
   862                          
   863                          
   864                          
   865                          
   866                          
   867                          
   868                             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   869                             ;; create open and closed FILE lists
   870                             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   871                          
   872                             ; __clib_fopen_max   = max number of open FILEs specified by user
   873                             ; 0 = number of static FILEs instantiated in crt
   874                             ; __i_stdio_file_n   = address of static FILE structure #n (0..I_STDIO_FILE_NUM-1)
   875                          
   876                          	PUBLIC __MAX_FOPEN
   877                          
   878                             SECTION data_clib
   879                             SECTION data_stdio
   880                          
   881                             IF (__clib_fopen_max > 0) || (0 > 0)
   882                          
   883                                ; number of FILEs > 0
   884                          
   885                                ; construct list of open files
   886                          
   887                                IF 0 > 0
   888                          
   889                                   ; number of FILEs statically generated > 0
   890                          
   891                                   SECTION data_clib
   892                                   SECTION data_stdio
   893                          
   894                                   PUBLIC __stdio_open_file_list
   895                          
   896                                   __stdio_open_file_list:  defw __i_stdio_file_-1
   897                          
   898                                ELSE
   899                          
   900                                   ; number of FILEs statically generated = 0
   901                          
   902                                   SECTION bss_clib
   903                                   SECTION bss_stdio
   904                          
   905                                   PUBLIC __stdio_open_file_list
   906                          
   907                                   __stdio_open_file_list:  defw 0
   908                          
   909                                ENDIF
   910                          
   911                                ; construct list of closed / available FILEs
   912                          
   913                                SECTION data_clib
   914                                SECTION data_stdio
   915                          
   916                                PUBLIC __stdio_closed_file_list
   917                          
   918                                __stdio_closed_file_list:   defw 0, __stdio_closed_file_list
   919                          
   920                                IF __clib_fopen_max > 0
   921                          
   922                                   defc __MAX_FOPEN = __clib_fopen_max
   923                          
   924                                   ; create extra FILE structures
   925                          
   926                                   SECTION bss_clib
   927                                   SECTION bss_stdio
   928                          
   929                                   __stdio_file_extra:      defs (__clib_fopen_max - 0) * 15
   930                          
   931                                   SECTION code_crt_init
   932                          
   933                                      ld bc,__stdio_closed_file_list
   934                                      ld de,__stdio_file_extra
   935                                      ld l,__clib_fopen_max - 0
   936                          
   937                                   loop:
   938                          
   939                                      push hl
   940                          
   941                                      EXTERN asm_p_forward_list_alt_push_front
   942                                      call asm_p_forward_list_alt_push_front
   943                          
   944                                      ld de,15
   945                                      add hl,de
   946                                      ex de,hl
   947                          
   948                                      pop hl
   949                          
   950                                      dec l
   951                                      jr nz, loop
   952                          
   953                                ELSE
   954                          
   955                                   defc __MAX_FOPEN = 0
   956                          
   957                                ENDIF
   958                          
   959                             ENDIF
   960                          
   961                             IF (__clib_fopen_max = 0) && (0 = 0)
   962                          
   963                                defc __MAX_FOPEN = 0
   964                          
   965                                ; create empty file lists
   966                          
   967                                SECTION bss_clib
   968                                SECTION bss_stdio
   969                          
   970                                PUBLIC __stdio_open_file_list
   971  0000  0000                    __stdio_open_file_list:  defw 0
   972                          
   973                                SECTION data_clib
   974                                SECTION data_stdio
   975                          
   976                                PUBLIC __stdio_closed_file_list
   977  0000  00000000                __stdio_closed_file_list:   defw 0, __stdio_closed_file_list
   978                          
