  2138                          sequal:
  2139                          
  2140                          
  2141  06c3  c5                        push bc
  2142  06c4  d9                        exx
  2143  06c5  c1                        pop bc      ; count
  2144  06c6  e1                        pop hl      ; addr2
  2145  06c7  d1                        pop de      ; addr1
  2146  06c8  78                        ld a,b      ; test for count=0
  2147  06c9  b1                        or c
  2148  06ca  2809                      jr z,smatch     ; by definition, match!
  2149  06cc  1a                sloop:  ld a,(de)
  2150  06cd  13                        inc de
  2151  06ce  eda1                      cpi
  2152  06d0  2009                      jr nz,sdiff     ; char mismatch: exit
  2153  06d2  eacc06                    jp pe,sloop     ; count not exhausted
  2154                          smatch: ; count exhausted & no mismatch found
  2155  06d5  d9                        exx
  2156  06d6  010000                    ld bc,0         ; bc=0000  (s1=s2)
  2157  06d9  1808                      jr snext
  2158                          sdiff:  ; mismatch!  undo last 'cpi' increment
  2159  06db  2b                        dec hl          ; point at mismatch char
  2160  06dc  be                        cp (hl)         ; set cy if char1 < char2
  2161  06dd  9f                        sbc a,a         ; propagate cy thru A
  2162  06de  d9                        exx
  2163  06df  47                        ld b,a          ; bc=FFFF if cy (s1<s2)
  2164  06e0  f601                      or 1            ; bc=0001 if ncy (s1>s2)
  2165  06e2  4f                        ld c,a
  2166                          snext:
  2167  06e3  eb                        ex de,hl
  2168                          
  2169  06e4  5e                        ld e,(hl)
  2170  06e5  23                        inc hl
  2171  06e6  56                        ld d,(hl)
  2172  06e7  23                        inc hl
  2173  06e8  eb                        ex de,hl
  2174  06e9  e9                        jp (hl)
