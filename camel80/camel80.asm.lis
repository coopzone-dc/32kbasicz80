  2069  0683  7b                        ld a,e
  2070  0684  eda1              skiploop: cpi
  2071  0686  2005                      jr nz,skipmis   ; char mismatch: exit
  2072  0688  ea8406                    jp pe,skiploop  ; count not exhausted
  2073  068b  1802                      jr skipdone     ; count 0, no mismatch
