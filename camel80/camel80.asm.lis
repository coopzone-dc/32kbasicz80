  2110  06ab  7b                        ld a,e
  2111  06ac  edb1                      cpir        ; scan 'til match or count=0
  2112  06ae  2002                      jr nz,scandone  ; no match, BC & HL ok
  2113  06b0  03                        inc bc          ; match!  undo last to
  2114  06b1  2b                        dec hl          ;   point at match char
  2115  06b2  e5                scandone: push hl   ; updated address
  2116  06b3  c5                        push bc     ; updated count
  2117  06b4  d9                        exx
  2118  06b5  c1                        pop bc      ; TOS in bc
