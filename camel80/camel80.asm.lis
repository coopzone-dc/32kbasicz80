  1697  0519  dd6e00            looptst: ld l,(ix+0)  ; get the loop index
  1698  051c  dd6601                    ld h,(ix+1)
  1699  051f  b7                        or a
  1700  0520  ed4a                      adc hl,bc    ; increment w/overflow test
  1701  0522  ea2e05                    jp pe,loopterm  ; overflow=loop done
  1702                                  ; continue the loop
  1703  0525  dd7500                    ld (ix+0),l  ; save the updated index
  1704  0528  dd7401                    ld (ix+1),h
  1705  052b  d9                        exx
  1706  052c  188a                      jr dobranch  ; take the inline branch
  1707                          loopterm: ; terminate the loop
  1708  052e  010400                    ld bc,4      ; discard the loop info
  1709  0531  dd09                      add ix,bc
  1710  0533  d9                        exx
  1711  0534  13                        inc de       ; skip the inline branch
  1712  0535  13                        inc de
