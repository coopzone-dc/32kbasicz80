  1680                          ;Z (loop)   R: sys1 sys2 --  | sys1 sys2
  1681                          ;Z                        run-time code for LOOP
  1682                          ; Add 1 to the loop index.  If loop terminates,
  1683                          ; clean up the return stack and skip the branch.
  1684                          ; Else take the inline branch.  Note that LOOP
  1685                          ; terminates when index=8000h.
  1686                          
  1687  050b  df04                    dw xdo_link
  1688  050d  00                      db 0
