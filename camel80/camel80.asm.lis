    23                          ; ===============================================
    24                          ; CAMEL80.AZM: Code Primitives
    25                          ;   Source code is for the Z80MR macro assembler.
    26                          ;   Forth words are documented as follows:
    27                          ;x   NAME     stack -- stack    description
    28                          ;   where x=C for ANS Forth Core words, X for ANS
    29                          ;   Extensions, Z for internal or private words.
    30                          ;
    31                          ; Direct-Threaded Forth model for Zilog Z80
    32                          ; 16 bit cell, 8 bit char, 8 bit (byte) adrs unit
    33                          ;    Z80 BC = Forth TOS (top Param Stack item)
    34                          ;        HL =       W    working register
    35                          ;        DE =       IP   Interpreter Pointer
    36                          ;        SP =       PSP  Param Stack Pointer
    37                          ;        IX =       RSP  Return Stack Pointer
    38                          ;        IY =       UP   User area Pointer
    39                          ;    A, alternate register set = temporaries
    40                          ;
    41                          ; Revision history:
    42                          ;   19 Aug 94 v1.0
    43                          ;   25 Jan 95 v1.01  now using BDOS function 0Ah
    44                          ;       for interpreter input; TIB at 82h.
    45                          ;   02 Mar 95 v1.02  changed ALIGN to ALIGNED in
    46                          ;       S" (S"); changed ,BRANCH to ,XT in DO.
    47                          ; ===============================================
    48                          ; Macros to define Forth headers
    49                          ; HEAD  label,length,name,action
    50                          ; IMMED label,length,name,action
    51                          ;    label  = assembler name for this word
    52                          ;             (special characters not allowed)
    53                          ;    length = length of name field
    54                          ;    name   = Forth's name for this word
    55                          ;    action = code routine for this word, e.g.
    56                          ;             DOCOLON, or DOCODE for code words
    57                          ; IMMED defines a header for an IMMEDIATE word.
    58                          ;
    59                          
    60                          SECTION code_user
    61                          
    62                          PUBLIC main_code_start
    63                          PUBLIC main_code_warmstart
    64                          
    65                          
    66                          
    67                          
    68                          
    69                          
    70                          
    71                          
    72                          ; NEXTHL is used when the IP is already in HL.
    73                          
    74                          
    75                          ; The NEXT macro (7 bytes) assembles the 'next'
    76                          ; code in-line in every Z80 CamelForth CODE word.
    77                          
    78                          
    79                          
    80                          
    81                          ; RESET AND INTERRUPT VECTORS ===================
    82                          
    83                          ; RC2014 Entry points
    84                          
    85                          main_code_start:
    86  0000  3e00                      ld a, 0
    87  0002  c30a00                    jp main_code_init
    88                          
    89                          main_code_warmstart:
    90  0005  3e01                      ld a, 1
    91  0007  c30a00                    jp main_code_init
    92                          
    93                          main_code_init:
    94  000a  210028                    ld hl,$2800
    95  000d  25                        dec h        ; EM-100h
    96  000e  f9                        ld sp,hl     ;      = top of param stack
    97  000f  24                        inc h        ; EM
    98  0010  e5                        push hl
    99  0011  dde1                      pop ix       ;      = top of return stack
   100  0013  25                        dec h        ; EM-200h
   101  0014  25                        dec h
   102  0015  e5                        push hl
   103  0016  fde1                      pop iy       ;      = bottom of user area
   104  0018  110100                    ld de,1      ; do reset if COLD returns
   105                          
   106  001b  b7                        or a
   107  001c  ca5816                    jp z, COLD
   108  001f  c39516                    jp WARM
   109                          
   110                          
   111                          ; Memory map:
   112                          ;   8000h       ACIA buffers
   113                          ;   8200h       ACIA buffers
   114                          ;   8400h       Terminal Input Buffer, 128 bytes
   115                          ;   EM-200h     User area, 128 bytes
   116                          ;   EM-180h     Parameter stack, 128B, grows down
   117                          ;   EM-100h     HOLD area, 40 bytes, grows down
   118                          ;   EM-0D8h     PAD buffer, 88 bytes
   119                          ;   EM-80h      Return stack, 128 B, grows down
   120                          ;   EM=87ffh    End of RAM workspace
   121                          ;   8800h       Forth kernel = start of CP/M TPA
   122                          ;     ? h       Forth dictionary (user RAM)
   123                          ;   FFFFh       Top of RAM
   124                          ; See also the definitions of U0, S0, and R0
   125                          ; in the "system variables & constants" area.
   126                          ; A task w/o terminal input requires 200h bytes.
   127                          ; Double all except TIB and PAD for 32-bit CPUs.
   128                          
   129                          ; INTERPRETER LOGIC =============================
   130                          ; See also "defining words" at end of this file
   131                          
   132                          ;C EXIT     --      exit a colon definition
   133                          
   134  0022  0000                    dw 0
   135  0024  00                      db 0
   136                          EXIT_link:
   137                          
   138  0025  0445584954              defm 4, "EXIT"
   139                          EXIT:
   140                          
   141                          
   142  002a  dd5e00                    ld e,(ix+0)    ; pop old IP from ret stk
   143  002d  dd23                      inc ix
   144  002f  dd5600                    ld d,(ix+0)
   145  0032  dd23                      inc ix
   146                          
   147  0034  eb                        ex de,hl
   148                          
   149  0035  5e                        ld e,(hl)
   150  0036  23                        inc hl
   151  0037  56                        ld d,(hl)
   152  0038  23                        inc hl
   153  0039  eb                        ex de,hl
   154  003a  e9                        jp (hl)
   155                          
   156                          
   157                          ;Z lit      -- x    fetch inline literal to stack
   158                          ; This is the primtive compiled by LITERAL.
   159                          
   160  003b  2500                    dw EXIT_link
   161  003d  00                      db 0
   162                          lit_link:
   163                          
   164  003e  034c4954                defm 3, "LIT"
   165                          lit:
   166                          
   167                          
   168  0042  c5                        push bc        ; push old TOS
   169  0043  1a                        ld a,(de)      ; fetch cell at IP to TOS,
   170  0044  4f                        ld c,a         ;        advancing IP
   171  0045  13                        inc de
   172  0046  1a                        ld a,(de)
   173  0047  47                        ld b,a
   174  0048  13                        inc de
   175                          
   176  0049  eb                        ex de,hl
   177                          
   178  004a  5e                        ld e,(hl)
   179  004b  23                        inc hl
   180  004c  56                        ld d,(hl)
   181  004d  23                        inc hl
   182  004e  eb                        ex de,hl
   183  004f  e9                        jp (hl)
   184                          
   185                          
   186                          ;C EXECUTE   i*x xt -- j*x   execute Forth word
   187                          ;C                           at 'xt'
   188                          
   189  0050  3e00                    dw lit_link
   190  0052  00                      db 0
   191                          EXECUTE_link:
   192                          
   193  0053  0745584543555445        defm 7, "EXECUTE"
   194                          EXECUTE:
   195                          
   196                          
   197  005b  60                        ld h,b          ; address of word -> HL
   198  005c  69                        ld l,c
   199  005d  c1                        pop bc          ; get new TOS
   200  005e  e9                        jp (hl)         ; go do Forth word
   201                          
   202                          ; DEFINING WORDS ================================
   203                          
   204                          ; ENTER, a.k.a. DOCOLON, entered by CALL ENTER
   205                          ; to enter a new high-level thread (colon def'n.)
   206                          ; (internal code fragment, not a Forth word)
   207                          ; N.B.: DOCOLON must be defined before any
   208                          ; appearance of 'docolon' in a 'word' macro!
   209                          docolon:               ; (alternate name)
   210  005f  dd2b              enter:  dec ix         ; push old IP on ret stack
   211  0061  dd7200                    ld (ix+0),d
   212  0064  dd2b                      dec ix
   213  0066  dd7300                    ld (ix+0),e
   214  0069  e1                        pop hl         ; param field adrs -> IP
   215                          
   216  006a  5e                        ld e,(hl)
   217  006b  23                        inc hl
   218  006c  56                        ld d,(hl)
   219  006d  23                        inc hl
   220  006e  eb                        ex de,hl
   221  006f  e9                        jp (hl)
   222                          
   223                          ;C VARIABLE   --      define a Forth variable
   224                          ;   CREATE 1 CELLS ALLOT ;
   225                          ; Action of RAM variable is identical to CREATE,
   226                          ; so we don't need a DOES> clause to change it.
   227                          
   228  0070  5300                    dw EXECUTE_link
   229  0072  00                      db 0
   230                          VARIABLE_link:
   231                          
   232  0073  085641524941424c        defm 8, "VARIABLE"
              45                
   233                          VARIABLE:
   234  007c  cd5f00                  call docolon
   235                          
   236  007f  c911420001002f07          DW CREATE,lit,1,CELLS,ALLOT,EXIT
              d60d2a00          
   237                          ; DOVAR, code action of VARIABLE, entered by CALL
   238                          ; DOCREATE, code action of newly created words
   239                          docreate:
   240                          dovar:  ; -- a-addr
   241  008b  e1                        pop hl     ; parameter field address
   242  008c  c5                        push bc    ; push old TOS
   243  008d  44                        ld b,h     ; pfa = variable's adrs -> TOS
   244  008e  4d                        ld c,l
   245                          
   246  008f  eb                        ex de,hl
   247                          
   248  0090  5e                        ld e,(hl)
   249  0091  23                        inc hl
   250  0092  56                        ld d,(hl)
   251  0093  23                        inc hl
   252  0094  eb                        ex de,hl
   253  0095  e9                        jp (hl)
   254                          
   255                          
   256                          ;C CONSTANT   n --      define a Forth constant
   257                          ;   CREATE , DOES> (machine code fragment)
   258                          
   259  0096  7300                    dw VARIABLE_link
   260  0098  00                      db 0
   261                          CONSTANT_link:
   262                          
   263  0099  08434f4e5354414e        defm 8, "CONSTANT"
              54                
   264                          CONSTANT:
   265  00a2  cd5f00                  call docolon
   266                          
   267  00a5  c911e40dfb11              DW CREATE,COMMA,XDOES
   268                          ; DOCON, code action of CONSTANT,
   269                          ; entered by CALL DOCON
   270                          docon:  ; -- x
   271  00ab  e1                        pop hl     ; parameter field address
   272  00ac  c5                        push bc    ; push old TOS
   273  00ad  4e                        ld c,(hl)  ; fetch contents of parameter
   274  00ae  23                        inc hl     ;    field -> TOS
   275  00af  46                        ld b,(hl)
   276                          
   277  00b0  eb                        ex de,hl
   278                          
   279  00b1  5e                        ld e,(hl)
   280  00b2  23                        inc hl
   281  00b3  56                        ld d,(hl)
   282  00b4  23                        inc hl
   283  00b5  eb                        ex de,hl
   284  00b6  e9                        jp (hl)
   285                          
   286                          
   287                          ;Z USER     n --        define user variable 'n'
   288                          ;   CREATE , DOES> (machine code fragment)
   289                          
   290  00b7  9900                    dw CONSTANT_link
   291  00b9  00                      db 0
   292                          USER_link:
   293                          
   294  00ba  0455534552              defm 4, "USER"
   295                          USER:
   296  00bf  cd5f00                  call docolon
   297                          
   298  00c2  c911e40dfb11              DW CREATE,COMMA,XDOES
   299                          ; DOUSER, code action of USER,
   300                          ; entered by CALL DOUSER
   301                          douser:  ; -- a-addr
   302  00c8  e1                        pop hl     ; parameter field address
   303  00c9  c5                        push bc    ; push old TOS
   304  00ca  4e                        ld c,(hl)  ; fetch contents of parameter
   305  00cb  23                        inc hl     ;    field
   306  00cc  46                        ld b,(hl)
   307  00cd  fde5                      push iy    ; copy user base address to HL
   308  00cf  e1                        pop hl
   309  00d0  09                        add hl,bc  ;    and add offset
   310  00d1  44                        ld b,h     ; put result in TOS
   311  00d2  4d                        ld c,l
   312                          
   313  00d3  eb                        ex de,hl
   314                          
   315  00d4  5e                        ld e,(hl)
   316  00d5  23                        inc hl
   317  00d6  56                        ld d,(hl)
   318  00d7  23                        inc hl
   319  00d8  eb                        ex de,hl
   320  00d9  e9                        jp (hl)
   321                          
   322                          
   323                          ; DODOES, code action of DOES> clause
   324                          ; entered by       CALL fragment
   325                          ;                  parameter field
   326                          ;                       ...
   327                          ;        fragment: CALL DODOES
   328                          ;                  high-level thread
   329                          ; Enters high-level thread with address of
   330                          ; parameter field on top of stack.
   331                          ; (internal code fragment, not a Forth word)
   332                          dodoes: ; -- a-addr
   333  00da  dd2b                      dec ix         ; push old IP on ret stk
   334  00dc  dd7200                    ld (ix+0),d
   335  00df  dd2b                      dec ix
   336  00e1  dd7300                    ld (ix+0),e
   337  00e4  d1                        pop de         ; adrs of new thread -> IP
   338  00e5  e1                        pop hl         ; adrs of parameter field
   339  00e6  c5                        push bc        ; push old TOS onto stack
   340  00e7  44                        ld b,h         ; pfa -> new TOS
   341  00e8  4d                        ld c,l
   342                          
   343  00e9  eb                        ex de,hl
   344                          
   345  00ea  5e                        ld e,(hl)
   346  00eb  23                        inc hl
   347  00ec  56                        ld d,(hl)
   348  00ed  23                        inc hl
   349  00ee  eb                        ex de,hl
   350  00ef  e9                        jp (hl)
   351                          
