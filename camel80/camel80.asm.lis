  3770                          ;           ?NUMBER
  3771                          ;           IF POSTPONE LITERAL     converted ok
  3772                          ;           ELSE COUNT TYPE 3F EMIT CR ABORT  err
  3773                          ;           THEN
  3774                          ;       THEN
  3775                          ;   REPEAT DROP ;
