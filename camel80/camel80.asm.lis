  1882                          UMSLASHMOD:
  1883                          
  1884                          
  1885  05d9  c5                        push bc
  1886  05da  d9                        exx
  1887  05db  c1                        pop bc      ; BC = divisor
  1888  05dc  e1                        pop hl      ; HLDE = dividend
  1889  05dd  d1                        pop de
  1890  05de  3e10                      ld a,16     ; loop counter
  1891  05e0  cb23                      sla e
  1892  05e2  cb12                      rl d        ; hi bit DE -> carry
  1893  05e4  ed6a              udloop: adc hl,hl   ; rot left w/ carry
  1894  05e6  3006                      jr nc,udiv3
  1895                                  ; case 1: 17 bit, cy:HL = 1xxxx
  1896  05e8  b7                        or a        ; we know we can subtract
  1897  05e9  ed42                      sbc hl,bc
  1898  05eb  b7                        or a        ; clear cy to indicate sub ok
  1899  05ec  1806                      jr udiv4
  1900                                  ; case 2: 16 bit, cy:HL = 0xxxx
  1901  05ee  ed42              udiv3:  sbc hl,bc   ; try the subtract
  1902  05f0  3002                      jr nc,udiv4 ; if no cy, subtract ok
  1903  05f2  09                        add hl,bc   ; else cancel the subtract
  1904  05f3  37                        scf         ;   and set cy to indicate
  1905  05f4  cb13              udiv4:  rl e        ; rotate result bit into DE,
  1906  05f6  cb12                      rl d        ; and next bit of DE into cy
  1907  05f8  3d                        dec a
  1908  05f9  20e9                      jr nz,udloop
  1909                                  ; now have complemented quotient in DE,
  1910                                  ; and remainder in HL
  1911  05fb  7a                        ld a,d
  1912  05fc  2f                        cpl
  1913  05fd  47                        ld b,a
  1914  05fe  7b                        ld a,e
  1915  05ff  2f                        cpl
  1916  0600  4f                        ld c,a
  1917  0601  e5                        push hl     ; push remainder
  1918  0602  c5                        push bc
  1919  0603  d9                        exx
  1920  0604  c1                        pop bc      ; quotient remains in TOS
  1921                          
  1922  0605  eb                        ex de,hl
  1923                          
  1924  0606  5e                        ld e,(hl)
  1925  0607  23                        inc hl
  1926  0608  56                        ld d,(hl)
  1927  0609  23                        inc hl
  1928  060a  eb                        ex de,hl
  1929  060b  e9                        jp (hl)
