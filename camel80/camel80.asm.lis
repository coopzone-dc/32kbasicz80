  1633                          ;Z (do)    n1|u1 n2|u2 --  R: -- sys1 sys2
  1634                          ;Z                          run-time code for DO
  1635                          ; '83 and ANSI standard loops terminate when the
  1636                          ; boundary of limit-1 and limit is crossed, in
  1637                          ; either direction.  This can be conveniently
  1638                          ; implemented by making the limit 8000h, so that
  1639                          ; arithmetic overflow logic can detect crossing.
  1640                          ; I learned this trick from Laxen & Perry F83.
  1641                          ; fudge factor = 8000h-limit, to be added to
  1642                          ; the start value.
  1643                          
  1644  04dc  c604                    dw qbranch_link
  1645  04de  00                      db 0
  1646                          xdo_link:
  1647                          
  1648  04df  0428646f29              defm 4, "(do)"
  1649                          xdo:
  1650                          
  1651                          
  1652  04e4  eb                        ex de,hl
  1653  04e5  e3                        ex (sp),hl   ; IP on stack, limit in HL
  1654  04e6  eb                        ex de,hl
  1655  04e7  210080                    ld hl,8000h
  1656  04ea  b7                        or a
  1657  04eb  ed52                      sbc hl,de    ; 8000-limit in HL
  1658  04ed  dd2b                      dec ix       ; push this fudge factor
  1659  04ef  dd7400                    ld (ix+0),h  ;    onto return stack
  1660  04f2  dd2b                      dec ix       ;    for later use by 'I'
  1661  04f4  dd7500                    ld (ix+0),l
  1662  04f7  09                        add hl,bc    ; add fudge to start value
  1663  04f8  dd2b                      dec ix       ; push adjusted start value
  1664  04fa  dd7400                    ld (ix+0),h  ;    onto return stack
  1665  04fd  dd2b                      dec ix       ;    as the loop index.
  1666  04ff  dd7500                    ld (ix+0),l
  1667  0502  d1                        pop de       ; restore the saved IP
  1668  0503  c1                        pop bc       ; pop new TOS
  1669                          
  1670  0504  eb                        ex de,hl
  1671                          
  1672  0505  5e                        ld e,(hl)
  1673  0506  23                        inc hl
  1674  0507  56                        ld d,(hl)
  1675  0508  23                        inc hl
  1676  0509  eb                        ex de,hl
  1677  050a  e9                        jp (hl)
