  1714  0536  eb                        ex de,hl
  1715                          
  1716  0537  5e                        ld e,(hl)
  1717  0538  23                        inc hl
  1718  0539  56                        ld d,(hl)
  1719  053a  23                        inc hl
  1720  053b  eb                        ex de,hl
  1721  053c  e9                        jp (hl)
  1722                          
  1723                          
