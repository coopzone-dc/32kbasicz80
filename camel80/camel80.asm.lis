  1946  0616  c1                        pop bc          ; count in bc
  1947  0617  d1                        pop de          ; address in de
  1948  0618  b7                        or a            ; clear carry flag
  1949  0619  21ffff                    ld hl,0ffffh
  1950  061c  ed4a                      adc hl,bc       ; test for count=0 or 1
  1951  061e  3009                      jr nc,filldone  ;   no cy: count=0, skip
  1952  0620  12                        ld (de),a       ; fill first byte
  1953  0621  2806                      jr z,filldone   ;   zero, count=1, done
  1954  0623  0b                        dec bc          ; else adjust count,
  1955  0624  62                        ld h,d          ;   let hl = start adrs,
  1956  0625  6b                        ld l,e
  1957  0626  13                        inc de          ;   let de = start adrs+1
  1958  0627  edb0                      ldir            ;   copy (hl)->(de)
  1959  0629  d9                filldone: exx           ; back to main reg set
  1960  062a  c1                        pop bc          ; pop new TOS
  1961                          
  1962  062b  eb                        ex de,hl
  1963                          
  1964  062c  5e                        ld e,(hl)
  1965  062d  23                        inc hl
  1966  062e  56                        ld d,(hl)
  1967  062f  23                        inc hl
