  2416                          ; CONTROL STRUCTURES ============================
  2417                          ; These words allow Forth control structure words
  2418                          ; to be defined portably.
  2419                          
  2420                          ;Z ,BRANCH   xt --    append a branch instruction
  2421                          ; xt is the branch operator to use, e.g. qbranch
  2422                          ; or (loop).  It does NOT append the destination
  2423                          ; address.  On the Z80 this is equivalent to ,XT.
  2424                          
  2425  07c9  b807                    dw CEXIT_link
  2426  07cb  00                      db 0
  2427                          COMMABRANCH_link:
  2428                          
  2429  07cc  072c4252414e4348        defm 7, ",BRANCH"
  2430                          COMMABRANCH:
  2431                          
  2432                          
  2433  07d4  c3e40d                    jp COMMA
  2434                          
  2435                          ;Z ,DEST   dest --        append a branch address
  2436                          ; This appends the given destination address to
  2437                          ; the branch instruction.  On the Z80 this is ','
  2438                          ; ...other CPUs may use relative addressing.
  2439                          
  2440  07d7  cc07                    dw COMMABRANCH_link
  2441  07d9  00                      db 0
  2442                          COMMADEST_link:
  2443                          
  2444  07da  052c44455354            defm 5, ",DEST"
  2445                          COMMADEST:
  2446                          
  2447                          
  2448  07e0  c3e40d                    jp COMMA
  2449                          
  2450                          ;Z !DEST   dest adrs --    change a branch dest'n
  2451                          ; Changes the destination address found at 'adrs'
  2452                          ; to the given 'dest'.  On the Z80 this is '!'
  2453                          ; ...other CPUs may need relative addressing.
  2454                          
  2455  07e3  da07                    dw COMMADEST_link
  2456  07e5  00                      db 0
  2457                          STOREDEST_link:
  2458                          
  2459  07e6  052144455354            defm 5, "!DEST"
  2460                          STOREDEST:
  2461                          
  2462                          
  2463  07ec  c36b02                    jp STORE
  2464                          
  2465                          ; HEADER STRUCTURE ==============================
  2466                          ; The structure of the Forth dictionary headers
  2467                          ; (name, STOREDEST_link, immediate flag, and "smudge" bit)
  2468                          ; does not necessarily differ across CPUs.  This
  2469                          ; structure is not easily factored into distinct
  2470                          ; "portable" words; instead, it is implicit in
  2471                          ; the definitions of FIND and CREATE, and also in
  2472                          ; NFA>LFA, NFA>CFA, IMMED?, IMMEDIATE, HIDE, and
  2473                          ; REVEAL.  These words must be (substantially)
  2474                          ; rewritten if either the header structure or its
  2475                          ; inherent assumptions are changed.
  2476                          
  2477                             ; CPU Dependencies
  2478                          ; LISTING 2.
