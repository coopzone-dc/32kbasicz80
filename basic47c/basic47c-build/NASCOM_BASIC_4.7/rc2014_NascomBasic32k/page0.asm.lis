    16                          
    17                          ;==============================================================================
    18                          ;
    19                          ; Z80 INTERRUPT ORIGINATING VECTOR TABLE
    20                          ;
    21                          SECTION         vector_rst
    22                          
    23                          EXTERN          INIT
    24                          
    25                          ;------------------------------------------------------------------------------
    26                          ; RST 00 - RESET / TRAP
    27                          ;               ALIGN    0x0000         ; ORG     0000H
    28  0000  c30000                            JP      INIT            ; Initialize Hardware and go
    29                          
    30                          ;------------------------------------------------------------------------------
    31                          ; RST 08
    32  0003  ffffffffff                        ALIGN   0x0008          ; ORG     0008H
    33  0008  c30000                            JP      VECTOR_BASE-VECTOR_PROTO+RST_08_LBL
    34                          
    35                          ;------------------------------------------------------------------------------
    36                          ; RST 10
    37  000b  ffffffffff                        ALIGN   0x0010          ; ORG     0010H
    38  0010  c30000                            JP      VECTOR_BASE-VECTOR_PROTO+RST_10_LBL
    39                          
    40                          ;------------------------------------------------------------------------------
    41                          ; RST 18
    42  0013  ffffffffff                        ALIGN   0x0018          ; ORG     0018H
    43  0018  c30000                            JP      VECTOR_BASE-VECTOR_PROTO+RST_18_LBL
    44                          
    45                          ;------------------------------------------------------------------------------
    46                          ; RST 20
    47  001b  ffffffffff                        ALIGN   0x0020          ; ORG     0020H
    48  0020  c30000                            JP      VECTOR_BASE-VECTOR_PROTO+RST_20_LBL
    49                          
    50                          ;------------------------------------------------------------------------------
    51                          ; RST 28
    52  0023  ffffffffff                        ALIGN   0x0028          ; ORG     0028H
    53  0028  c3d87f                            JP      VECTOR_BASE-VECTOR_PROTO+RST_28_LBL
    54                          
    55                          ;------------------------------------------------------------------------------
    56                          ; RST 30
    57  002b  ffffffffff                        ALIGN   0x0030          ; ORG     0030H
    58  0030  c3dc7f                            JP      VECTOR_BASE-VECTOR_PROTO+RST_30_LBL
    59                          
    60                          ;------------------------------------------------------------------------------
    61                          ; RST 38 - INTERRUPT VECTOR INT [ with IM 1 ]
    62                          
    63  0033  ffffffffff                        ALIGN   0x0038          ; ORG     0038H
    64  0038  c3e07f                            JP      VECTOR_BASE-VECTOR_PROTO+INT_INT_LBL
    65                          
    66                          ;------------------------------------------------------------------------------
    67                          ; NMI - INTERRUPT VECTOR NMI
    68                          
    69                          SECTION         vector_nmi
    70  0000  c30000                            JP      VECTOR_BASE-VECTOR_PROTO+INT_NMI_LBL
    71                          
    72                          ;==============================================================================
    73                          ;
    74                          ; Z80 INTERRUPT VECTOR TABLE PROTOTYPE
    75                          ;
    76                          ; WILL BE DUPLICATED DURING INIT TO:
    77                          ;
    78                          ;               ORG     VECTOR_BASE
    79                          
    80                          SECTION         vector_table_prototype
    81                          
    82                          EXTERN          RST_00, RST_08, RST_10, RST_18
    83                          EXTERN          RST_20, RST_28, RST_30
    84                          
    85                          EXTERN          INT_INT, INT_NMI
    86                          
    87                          .RST_00_LBL
    88  0000  c30000                            JP      RST_00
    89  0003  00                                NOP
    90                          .RST_08_LBL
    91  0004  c30000                            JP      RST_08
    92  0007  00                                NOP
    93                          .RST_10_LBL
    94  0008  c30000                            JP      RST_10
    95  000b  00                                NOP
    96                          .RST_18_LBL
    97  000c  3a2c80                            LD      A,(serRxBufUsed)    ; this is called each token,
    98  000f  c9                                RET                         ; so optimise it to here
    99                          .RST_20_LBL
   100  0010  c30000                            JP      RST_20
   101  0013  00                                NOP
   102                          .RST_28_LBL
   103  0014  c30000                            JP      RST_28
   104  0017  00                                NOP
   105                          .RST_30_LBL
   106  0018  c30000                            JP      RST_30
   107  001b  00                                NOP
   108                          .INT_INT_LBL
   109  001c  c30000                            JP      INT_INT
   110  001f  00                                NOP
   111                          .INT_NMI_LBL
   112  0020  c30000                            JP      INT_NMI
   113  0023  00                                NOP
   114                          
   115                          ;------------------------------------------------------------------------------
   116                          ; NULL RETURN INSTRUCTIONS
   117                          
   118                          SECTION         vector_null_ret
   119                          
   120                          PUBLIC          NULL_NMI
   121                          
   122                          .NULL_NMI
   123  0000  ed00                              RETN
   124                          
   125                          ;==============================================================================
   126                          
   127                          
