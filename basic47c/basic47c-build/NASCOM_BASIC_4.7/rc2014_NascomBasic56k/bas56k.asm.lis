  4147                                  ; MEEK I,J where I is signed integer and J is 16 byte blocks
  4148                                  ; uses  : af, bc, de, hl
  4149                                  ; (C) feilipu
  4150                          
  4151                          MEEK:
  4152  1bb2  cd830c                    CALL    GETNUM          ; Get address
