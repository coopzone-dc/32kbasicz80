  4293                          HLOAD:
  4294  1c7c  c0                        ret NZ                  ; return if any more on line
  4295  1c7d  cda61c                    call HLD_WAIT_COLON     ; wait for first colon and address data
  4296  1c80  2ad122                    ld hl,(ARREND)          ; start of free memory
  4297  1c83  b7                        or a                    ; clear carry flag
  4298  1c84  ed52                      sbc hl,de
