  4309                          HLD_HIGH_RAM:
  4310  1c9e  13                        inc de
  4311  1c9f  ed530422                  ld (USR+1),de           ; store first address as "USR(x)" location
  4312  1ca3  c3c91c                    jp HLD_READ_DATA        ; now get the first data
  4313                          
  4314                          HLD_WAIT_COLON:
  4315  1ca6  d7                        rst 10h                 ; Rx byte in A
  4316  1ca7  fe3a                      cp ':'                  ; wait for ':'
  4317  1ca9  c2a61c                    jp NZ,HLD_WAIT_COLON
  4318  1cac  0e00                      ld c,0                  ; reset C to compute checksum
  4319  1cae  cde61c                    call HLD_READ_BYTE      ; read byte count
  4320  1cb1  47                        ld b,a                  ; store it in B
  4321  1cb2  cde61c                    call HLD_READ_BYTE      ; read upper byte of address
  4322  1cb5  57                        ld d,a                  ; store in D
  4323  1cb6  cde61c                    call HLD_READ_BYTE      ; read lower byte of address
  4324  1cb9  5f                        ld e,a                  ; store in E
  4325  1cba  cde61c                    call HLD_READ_BYTE      ; read record type
  4326  1cbd  3d                        dec a                   ; check if record type is 01 (end of file)
  4327  1cbe  cadb1c                    jp Z,HLD_END_LOAD
  4328  1cc1  3c                        inc a                   ; check if record type is 00 (data)
  4329  1cc2  c29e03                    jp NZ,TMERR             ; if not, type mismatch error
  4330  1cc5  c9                        ret
  4331                          
  4332                          HLD_READ:
  4333  1cc6  cda61c                    call HLD_WAIT_COLON     ; wait for the next colon and address data
  4334                          HLD_READ_DATA:
  4335  1cc9  cde61c                    call HLD_READ_BYTE
  4336  1ccc  1213                      ld (de+),a              ; write the byte at the RAM address, increment
  4337  1cce  10f9                      djnz HLD_READ_DATA      ; if b non zero, loop to get more data
  4338                          
  4339                          HLD_READ_CHKSUM:
  4340  1cd0  cde61c                    call HLD_READ_BYTE      ; read checksum, but we don't need to keep it
  4341  1cd3  79                        ld a,c                  ; lower byte of C checksum should be 0
  4342  1cd4  b7                        or a
  4343  1cd5  c2a103                    jp NZ,HXERR             ; non zero, we have an issue
  4344  1cd8  c3c61c                    jp HLD_READ
  4345                          
  4346                          HLD_END_LOAD:
  4347  1cdb  cde61c                    call HLD_READ_BYTE      ; read checksum, but we don't need to keep it
  4348  1cde  79                        ld a,c                  ; lower byte of C checksum should be 0
  4349  1cdf  b7                        or a
  4350  1ce0  c2a103                    jp NZ,HXERR             ; non zero, we have an issue
  4351  1ce3  c3a200                    jp BRKRET               ; return to command line
  4352                          
  4353                          HLD_READ_BYTE:                  ; returns byte in A, checksum in C
  4354  1ce6  cdf71c                    call HLD_READ_NIBBLE    ; read the first nibble
  4355  1ce9  07                        rlca                    ; shift it left by 4 bits
  4356  1cea  07                        rlca
  4357  1ceb  07                        rlca
  4358  1cec  07                        rlca
  4359  1ced  6f                        ld l,a                  ; temporarily store the first nibble in L
  4360  1cee  cdf71c                    call HLD_READ_NIBBLE    ; get the second (low) nibble
  4361  1cf1  b5                        or l                    ; assemble two nibbles into one byte in A
  4362  1cf2  6f                        ld l,a                  ; put assembled byte back into L
  4363  1cf3  81                        add a,c                 ; add the byte read to C (for checksum)
  4364  1cf4  4f                        ld c,a
  4365  1cf5  7d                        ld a,l
  4366  1cf6  c9                        ret                     ; return the byte read in A (L = char received too)
  4367                          
  4368                          HLD_READ_NIBBLE:
  4369  1cf7  d7                        rst 10h                 ; Rx byte in A
  4370  1cf8  d630                      sub '0'
  4371  1cfa  fe0a                      cp 10
  4372  1cfc  d8                        ret C                   ; if A<10 just return
  4373  1cfd  d607                      sub 7                   ; else subtract 'A'-'0' (17) and add 10
  4374  1cff  c9                        ret
  4375                          
  4376                                  ; HEX$(nn) Convert signed 16 bit number to Hexadecimal string
  4377                                  ; (C) Searle
  4378                          
  4379  1d00  cda108            HEX:    CALL    DEINT           ; Get integer -32768 to 32767
  4380  1d03  c5                        PUSH    BC              ; Save contents of BC
  4381  1d04  21e022                    LD      HL,PBUFF
  4382  1d07  7a                        LD      A,D             ; Get high order into A
  4383  1d08  fe00                      CP      $0
  4384  1d0a  ca1a1d                    JP      Z,HEX2          ; Skip output if both high digits are zero
  4385  1d0d  cd391d                    CALL    BYT2ASC         ; Convert D to ASCII
  4386  1d10  78                        LD      A,B
  4387  1d11  fe30                      CP      '0'
  4388  1d13  ca181d                    JP      Z,HEX1          ; Don't store high digit if zero
  4389  1d16  70                        LD      (HL),B          ; Store it to PBUFF
  4390  1d17  23                        INC     HL              ; Next location
  4391  1d18  71                HEX1:   LD      (HL),C          ; Store C to PBUFF+1
  4392  1d19  23                        INC     HL              ; Next location
  4393  1d1a  7b                HEX2:   LD      A,E             ; Get lower byte
  4394  1d1b  cd391d                    CALL    BYT2ASC         ; Convert E to ASCII
  4395  1d1e  7a                        LD      A,D
  4396  1d1f  fe00                      CP      $0
  4397  1d21  c22a1d                    JP      NZ,HEX3         ; If upper byte was not zero then always print lower byte
  4398  1d24  78                        LD      A,B
  4399  1d25  fe30                      CP      '0'             ; If high digit of lower byte is zero then don't print
  4400  1d27  ca2c1d                    JP      Z,HEX4
  4401  1d2a  70                HEX3:   LD      (HL),B          ; to PBUFF+2
  4402  1d2b  23                        INC     HL              ; Next location
  4403  1d2c  71                HEX4:   LD      (HL),C          ; to PBUFF+3
  4404  1d2d  23                        INC     HL              ; PBUFF+4 to zero
  4405  1d2e  af                        XOR     A               ; Terminating character
  4406  1d2f  77                        LD      (HL),A          ; Store zero to terminate
  4407  1d30  23                        INC     HL              ; Make sure PBUFF is terminated
  4408  1d31  77                        LD      (HL),A          ; Store the double zero there
  4409  1d32  c1                        POP     BC              ; Get BC back
  4410  1d33  21e022                    LD      HL,PBUFF        ; Reset to start of PBUFF
  4411  1d36  c3ea10                    JP      STR1            ; Convert the PBUFF to a string and return it
  4412                          
  4413  1d39  47                BYT2ASC:LD      B,A             ; Save original value
  4414  1d3a  e60f                      AND     $0F             ; Strip off upper nybble
  4415  1d3c  fe0a                      CP      $0A             ; 0-9?
  4416  1d3e  da431d                    JP      C,ADD30         ; If A-F, add 7 more
  4417  1d41  c607                      ADD     A,$07           ; Bring value up to ASCII A-F
  4418  1d43  c630              ADD30:  ADD     A,$30           ; And make ASCII
  4419  1d45  4f                        LD      C,A             ; Save converted char to C
  4420  1d46  78                        LD      A,B             ; Retrieve original value
  4421  1d47  0f                        RRCA                    ; and Rotate it right
  4422  1d48  0f                        RRCA
  4423  1d49  0f                        RRCA
  4424  1d4a  0f                        RRCA
  4425  1d4b  e60f                      AND     $0F             ; Mask off upper nybble
  4426  1d4d  fe0a                      CP      $0A             ; 0-9? < A hex?
  4427  1d4f  da541d                    JP      C,ADD301        ; Skip Add 7
  4428  1d52  c607                      ADD     A,$07           ; Bring it up to ASCII A-F
  4429  1d54  c630              ADD301: ADD     A,$30           ; And make it full ASCII
  4430  1d56  47                        LD      B,A             ; Store high order byte
  4431  1d57  c9                        RET
  4432                          
  4433                                  ; Convert "&nnnn" ASCII HEX to FPREG
  4434                                  ; Gets a character from (HL) checks for Hexadecimal ASCII numbers "&nnnn"
  4435                                  ; Char is in A, NC if char is ;<=>?@ A-z, CY is set if 0-9
  4436                                  ; (C) Searle
  4437                          
  4438  1d58  eb                HEXTFP: EX      DE,HL           ; Move code string pointer to DE
  4439  1d59  210000                    LD      HL,0            ; Zero out the value
  4440  1d5c  cd741d                    CALL    GETHEX          ; Check the number for valid hex
  4441  1d5f  daa103                    JP      C,HXERR         ; First value wasn't hex, HX error
  4442  1d62  c36b1d                    JP      HEXLP1          ; Convert first character
  4443  1d65  cd741d            HEXLP:  CALL    GETHEX          ; Get second and additional characters
  4444  1d68  da911d                    JP      C,HEXIT         ; Exit if not a hex character
  4445  1d6b  29                HEXLP1: ADD     HL,HL           ; Shift 4 bits to the left
  4446  1d6c  29                        ADD     HL,HL
  4447  1d6d  29                        ADD     HL,HL
  4448  1d6e  29                        ADD     HL,HL
  4449  1d6f  b5                        OR      L               ; Add in D0-D3 into L
  4450  1d70  6f                        LD      L,A             ; Save new value
  4451  1d71  c3651d                    JP      HEXLP           ; And continue until all hex characters are in
  4452                          
  4453  1d74  13                GETHEX: INC     DE              ; Next location
  4454  1d75  1a                        LD      A,(DE)          ; Load character at pointer
  4455  1d76  fe48                      CP      'H'
  4456  1d78  ca741d                    JP      Z,GETHEX        ; Skip "H"
  4457  1d7b  fe20                      CP      ' '
  4458  1d7d  ca741d                    JP      Z,GETHEX        ; Skip spaces
  4459  1d80  d630                      SUB     $30             ; Get absolute value
  4460  1d82  d8                        RET     C               ; < "0", error
  4461  1d83  fe0a                      CP      $0A
  4462  1d85  da8d1d                    JP      C,NOSUB7        ; Is already in the range 0-9
  4463  1d88  d607                      SUB     $07             ; Reduce to A-F
  4464  1d8a  fe0a                      CP      $0A             ; Value should be $0A-$0F at this point
  4465  1d8c  d8                        RET     C               ; CY set if was :            ; < = > ? @
  4466  1d8d  fe10              NOSUB7: CP      $10             ; > Greater than "F"?
  4467  1d8f  3f                        CCF
  4468  1d90  c9                        RET                     ; CY set if it wasn't valid hex
  4469                          
  4470  1d91  eb                HEXIT:  EX      DE,HL           ; Value into DE, Code string into HL
  4471  1d92  7a                        LD      A,D             ; Load DE into AC
  4472  1d93  4b                        LD      C,E             ; For prep to
  4473  1d94  e5                        PUSH    HL
  4474  1d95  cd3310                    CALL    ACPASS          ; ACPASS to set AC as integer into FPREG
  4475  1d98  e1                        POP     HL
  4476  1d99  c9                        RET
  4477                          
  4478                          END:
