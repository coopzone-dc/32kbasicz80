    38                          ; GENERAL EQUATES
    39                          
    40                                  DEFC    CTRLC   =   03H         ; Control "C"
    41                                  DEFC    CTRLG   =   07H         ; Control "G"
    42                                  DEFC    BKSP    =   08H         ; Back space
    43                                  DEFC    LF      =   0AH         ; Line feed
    44                                  DEFC    FF      =   0CH         ; Form feed
    45                                  DEFC    CR      =   0DH         ; Carriage return
    46                                  DEFC    CTRLO   =   0FH         ; Control "O"
    47                                  DEFC    CTRLQ   =   11H         ; Control "Q"
    48                                  DEFC    CTRLR   =   12H         ; Control "R"
    49                                  DEFC    CTRLS   =   13H         ; Control "S"
    50                                  DEFC    CTRLU   =   15H         ; Control "U"
    51                                  DEFC    ESC     =   1BH         ; Escape
    52                                  DEFC    DEL     =   7FH         ; Delete
    53                          
    54                          ; BASIC WORK SPACE LOCATIONS
    55                          
    56                                  PUBLIC WRKSPC                   ; Start of BASIC RAM
    57                          
    58                                  DEFC    WRKSPC  =   2200H       ; <<<< BASIC Work space ** Rx buffer & Tx buffer located from 2080H **
    59                                  DEFC    USR     =   WRKSPC+003H ; "USR (x)" jump
    60                                  DEFC    OUTSUB  =   WRKSPC+006H ; "OUT p,n"
    61                                  DEFC    OTPORT  =   WRKSPC+007H ; Port (p)
    62                                  DEFC    DIVSUP  =   WRKSPC+009H ; Division support routine
    63                                  DEFC    DIV1    =   WRKSPC+00AH ; <- Values
    64                                  DEFC    DIV2    =   WRKSPC+00EH ; <-   to
    65                                  DEFC    DIV3    =   WRKSPC+012H ; <-   be
    66                                  DEFC    DIV4    =   WRKSPC+015H ; <-inserted
    67                                  DEFC    SEED    =   WRKSPC+017H ; Random number seed
    68                                  DEFC    LSTRND  =   WRKSPC+03AH ; Last random number
    69                                  DEFC    INPSUB  =   WRKSPC+03EH ; #INP (x)" Routine
    70                                  DEFC    INPORT  =   WRKSPC+03FH ; PORT (x)
    71                                  DEFC    NULLS   =   WRKSPC+041H ; Number of nulls
    72                                  DEFC    LWIDTH  =   WRKSPC+042H ; Terminal width
    73                                  DEFC    COMMAN  =   WRKSPC+043H ; Width for commas
    74                                  DEFC    NULFLG  =   WRKSPC+044H ; Null after input byte flag
    75                                  DEFC    CTLOFG  =   WRKSPC+045H ; Control "O" flag
    76                                  DEFC    LINESC  =   WRKSPC+046H ; Lines counter
    77                                  DEFC    LINESN  =   WRKSPC+048H ; Lines number
    78                                  DEFC    CHKSUM  =   WRKSPC+04AH ; Array load/save check sum
    79                                  DEFC    NMIFLG  =   WRKSPC+04CH ; Flag for NMI break routine
    80                                  DEFC    BRKFLG  =   WRKSPC+04DH ; Break flag
    81                                  DEFC    RINPUT  =   WRKSPC+04EH ; Input reflection
    82                                  DEFC    STRSPC  =   WRKSPC+051H ; Bottom of string space
    83                                  DEFC    LINEAT  =   WRKSPC+053H ; Current line number
    84                                  DEFC    BASTXT  =   WRKSPC+055H ; Pointer to start of program
    85                                  DEFC    BUFFER  =   WRKSPC+058H ; Input buffer
    86                                  DEFC    STACK   =   WRKSPC+05DH ; Initial stack
    87                                  DEFC    CURPOS  =   WRKSPC+0A2H ; <<<< Character position on line ** Top of Loader TEMPSTACK **
    88                                  DEFC    LCRFLG  =   WRKSPC+0A3H ; Locate/Create flag
    89                                  DEFC    TYPE    =   WRKSPC+0A4H ; Data type flag
    90                                  DEFC    DATFLG  =   WRKSPC+0A5H ; Literal statement flag
    91                                  DEFC    LSTRAM  =   WRKSPC+0A6H ; Last available RAM
    92                                  DEFC    TMSTPT  =   WRKSPC+0A8H ; Temporary string pointer
    93                                  DEFC    TMSTPL  =   WRKSPC+0AAH ; Temporary string pool
    94                                  DEFC    TMPSTR  =   WRKSPC+0B6H ; Temporary string
    95                                  DEFC    STRBOT  =   WRKSPC+0BAH ; Bottom of string space
    96                                  DEFC    CUROPR  =   WRKSPC+0BCH ; Current operator in EVAL
    97                                  DEFC    LOOPST  =   WRKSPC+0BEH ; First statement of loop
    98                                  DEFC    DATLIN  =   WRKSPC+0C0H ; Line of current DATA item
    99                                  DEFC    FORFLG  =   WRKSPC+0C2H ; "FOR" loop flag
   100                                  DEFC    LSTBIN  =   WRKSPC+0C3H ; Last byte entered
   101                                  DEFC    READFG  =   WRKSPC+0C4H ; Read/Input flag
   102                                  DEFC    BRKLIN  =   WRKSPC+0C5H ; Line of break
   103                                  DEFC    NXTOPR  =   WRKSPC+0C7H ; Next operator in EVAL
   104                                  DEFC    ERRLIN  =   WRKSPC+0C9H ; Line of error
   105                                  DEFC    CONTAD  =   WRKSPC+0CBH ; Where to CONTinue
   106                                  DEFC    PROGND  =   WRKSPC+0CDH ; End of program
   107                                  DEFC    VAREND  =   WRKSPC+0CFH ; End of variables
   108                                  DEFC    ARREND  =   WRKSPC+0D1H ; End of arrays
   109                                  DEFC    NXTDAT  =   WRKSPC+0D3H ; Next data item
   110                                  DEFC    FNRGNM  =   WRKSPC+0D5H ; Name of FN argument
   111                                  DEFC    FNARG   =   WRKSPC+0D7H ; FN argument value
   112                                  DEFC    FPREG   =   WRKSPC+0DBH ; Floating point register
   113                                  DEFC    FPEXP   =   FPREG+3     ; Floating point exponent
   114                                  DEFC    SGNRES  =   WRKSPC+0DFH ; Sign of result
   115                                  DEFC    PBUFF   =   WRKSPC+0E0H ; Number print buffer
   116                                  DEFC    MULVAL  =   WRKSPC+0EDH ; Multiplier
   117                                  DEFC    PROGST  =   WRKSPC+0F0H ; Start of program text area
   118                                  DEFC    STLOOK  =   WRKSPC+154H ; Start of memory test
   119                          
   120                          ; BASIC ERROR CODE VALUES
   121                          
   122                                  PUBLIC  UFERR           ; User Function undefined (RSTnn) error
   123                          
   124                                  DEFC    NF      =   00H ; NEXT without FOR
   125                                  DEFC    SN      =   02H ; Syntax error
   126                                  DEFC    RG      =   04H ; RETURN without GOSUB
   127                                  DEFC    OD      =   06H ; Out of DATA
   128                                  DEFC    FC      =   08H ; Function call error
   129                                  DEFC    OV      =   0AH ; Overflow
   130                                  DEFC    OM      =   0CH ; Out of memory
   131                                  DEFC    UL      =   0EH ; Undefined line number
   132                                  DEFC    BS      =   10H ; Bad subscript
   133                                  DEFC    DD      =   12H ; Re-DIMensioned array
   134                                  DEFC    DZ      =   14H ; Division by zero (/0)
   135                                  DEFC    ID      =   16H ; Illegal direct
   136                                  DEFC    TM      =   18H ; Type miss-match
   137                                  DEFC    OS      =   1AH ; Out of string space
   138                                  DEFC    LS      =   1CH ; String too long
   139                                  DEFC    ST      =   1EH ; String formula too complex
   140                                  DEFC    CN      =   20H ; Can't CONTinue
   141                                  DEFC    UF      =   22H ; UnDEFined user function FN
   142                                  DEFC    MO      =   24H ; Missing operand
   143                                  DEFC    HX      =   26H ; HEX error
   144                          
   145                          ; BASIC CODE COMMENCES
   146                          
   147                                  ORG     0240H           ; <<<< Modified to allow for ACIA Tx/Rx on RST_38 (INT)
   148                          
   149  0000  c31000            COLD:   JP      CSTART          ; Jump in for cold start (0x0240)
   150  0003  c39f00            WARM:   JP      WARMST          ; Jump in for warm start (0x0243)
   151                          
   152  0006  ffffffffff                DEFS    5               ; pad so DEINT is 0x024B, ABPASS is 0x024D
   153                          
   154  000b  a108                      DEFW    DEINT           ; 0x024B Get integer -32768 to 32767
   155  000d  3410                      DEFW    ABPASS          ; 0x024D Return integer in AB
   156                          
   157  000f  c0                RESET:  RET     NZ              ; Return if any more on line
   158  0010  210022            CSTART: LD      HL,WRKSPC       ; Start of workspace RAM
   159  0013  f9                        LD      SP,HL           ; Set up a temporary stack
   160  0014  af                        XOR     A               ; Clear break flag
   161  0015  324d22                    LD      (BRKFLG),A
   162                          
   163  0018  21c302            INIT:   LD      HL,INITAB       ; Initialise workspace
   164  001b  015a00                    LD      BC,INITBE-INITAB+3  ; Bytes to copy
   165  001e  110022                    LD      DE,WRKSPC       ; Into workspace RAM
   166  0021  edb0                      LDIR                    ; Copy
   167  0023  eb                        EX      DE,HL           ; End of copy destination to HL
   168  0024  f9                        LD      SP,HL           ; Temporary stack
   169  0025  cdbe04                    CALL    CLREG           ; Clear registers and stack
   170  0028  cda60a                    CALL    PRNTCRLF        ; Output CRLF
   171  002b  32a122                    LD      (BUFFER+72+1),A ; Mark end of buffer
   172  002e  32f022                    LD      (PROGST),A      ; Initialise program area
   173  0031  21ee00            MSIZE:  LD      HL,MEMMSG       ; Point to message
   174  0034  cd6111                    CALL    PRS             ; Output "Memory size"
   175  0037  cddb04                    CALL    PROMPT          ; Get input with '?'
   176  003a  cdea07                    CALL    GETCHR          ; Get next character
   177  003d  c25500                    JP      NZ,TSTMEM       ; If number - Test if RAM there
   178  0040  215423                    LD      HL,STLOOK       ; Point to start of RAM
   179  0043  23                MLOOP:  INC     HL              ; Next byte
   180  0044  7c                        LD      A,H             ; Above address FFFF ?
   181  0045  b5                        OR      L
   182  0046  ca6700                    JP      Z,SETTOP        ; Yes - 64K RAM
   183  0049  7e                        LD      A,(HL)          ; Get contents
   184  004a  47                        LD      B,A             ; Save it
   185  004b  2f                        CPL                     ; Flip all bits
   186  004c  77                        LD      (HL),A          ; Put it back
   187  004d  be                        CP      (HL)            ; RAM there if same
   188  004e  70                        LD      (HL),B          ; Restore old contents
   189  004f  ca4300                    JP      Z,MLOOP         ; If RAM - test next byte
   190  0052  c36700                    JP      SETTOP          ; Top of RAM found
   191                          
   192  0055  cdbb08            TSTMEM: CALL    ATOH            ; Get high memory into DE
   193  0058  b7                        OR      A               ; Set flags on last byte
   194  0059  c28c03                    JP      NZ,SNERR        ; ?SN Error if bad character
   195  005c  eb                        EX      DE,HL           ; Address into HL
   196  005d  2b                        DEC     HL              ; Back one byte
   197  005e  3ed9                      LD      A,11011001B     ; Test byte
   198  0060  46                        LD      B,(HL)          ; Get old contents
   199  0061  77                        LD      (HL),A          ; Load test byte
   200  0062  be                        CP      (HL)            ; RAM there if same
   201  0063  70                        LD      (HL),B          ; Restore old contents
   202  0064  c23100                    JP      NZ,MSIZE        ; Ask again if no RAM
   203                          
   204  0067  2b                SETTOP: DEC     HL              ; Back one byte
   205  0068  115323                    LD      DE,STLOOK-1     ; See if enough RAM
   206  006b  cd5406                    CALL    CPDEHL          ; Compare DE with HL
   207  006e  da3100                    JP      C,MSIZE         ; Ask again if not enough RAM
   208  0071  11ceff                    LD      DE,-50          ; 50 Bytes string space
   209  0074  22a622                    LD      (LSTRAM),HL     ; Save last available RAM
   210  0077  19                        ADD     HL,DE           ; Allocate string space
   211  0078  225122                    LD      (STRSPC),HL     ; Save string space
   212  007b  cd9904                    CALL    CLRPTR          ; Clear program area
   213  007e  2a5122                    LD      HL,(STRSPC)     ; Get end of memory
   214  0081  11efff                    LD      DE,-17          ; Offset for free bytes
   215  0084  19                        ADD     HL,DE           ; Adjust HL
   216  0085  11f022                    LD      DE,PROGST       ; Start of program text
   217  0088  7d                        LD      A,L             ; Get LSB
   218  0089  93                        SUB     E               ; Adjust it
   219  008a  6f                        LD      L,A             ; Re-save
   220  008b  7c                        LD      A,H             ; Get MSB
   221  008c  9a                        SBC     A,D             ; Adjust it
   222  008d  67                        LD      H,A             ; Re-save
   223  008e  e5                        PUSH    HL              ; Save bytes free
   224  008f  21b700                    LD      HL,SIGNON       ; Sign-on message
   225  0092  cd6111                    CALL    PRS             ; Output string
   226  0095  e1                        POP     HL              ; Get bytes free back
   227  0096  cdf617                    CALL    PRNTHL          ; Output amount of free memory
   228  0099  21a800                    LD      HL,BFREE        ; " Bytes free" message
   229  009c  cd6111                    CALL    PRS             ; Output string
   230                          
   231  009f  315d22            WARMST: LD      SP,STACK        ; Temporary stack
   232  00a2  cdbe04            BRKRET: CALL    CLREG           ; Clear registers and stack
   233  00a5  c3da03                    JP      PRNTOK          ; Go to get command line
   234                          
   235  00a8  2042797465732066  BFREE:  DEFB    " Bytes free",CR,LF,0,0
              7265650d0a0000    
   236                          
   237  00b7  5a38302042415349  SIGNON: DEFB    "Z80 BASIC Ver 4.7c",CR,LF
              432056657220342e  
              37630d0a          
   238  00cb  436f707972696768          DEFB    "Copyright ",40,"C",41
              7420284329        
   239  00d8  2031393738206279          DEFB    " 1978 by Microsoft",CR,LF,0,0
              204d6963726f736f  
              66740d0a0000      
   240                          
   241  00ee  4d656d6f72792074  MEMMSG: DEFB    "Memory top",0
              6f7000            
