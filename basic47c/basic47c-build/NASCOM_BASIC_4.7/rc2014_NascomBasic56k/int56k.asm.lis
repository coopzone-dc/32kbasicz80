   356                          ;==============================================================================
   357                          ;
   358                          ; Z80 INTERRUPT VECTOR PROTOTYPE ASSIGNMENTS
   359                          ;
   360                          
   361                          EXTERN  NULL_NMI                            ; RETN
   362                          EXTERN  UFERR                               ; User Function undefined (RSTnn) error
   363                          
   364                          PUBLIC  RST_00, RST_08, RST_10; RST_18
   365                          PUBLIC  RST_20, RST_28, RST_30
   366                          
   367                          PUBLIC  INT_INT, INT_NMI
   368                          
   369                          DEFC    RST_00      =       INIT            ; Initialise, should never get here
   370                          DEFC    RST_08      =       TXA             ; TX character, loop until space
   371                          DEFC    RST_10      =       RXA             ; RX character, loop until byte
   372                          ;       RST_18      =       RXA_CHK         ; Check receive buffer status, return # bytes available
   373                          DEFC    RST_20      =       UFERR           ; User Function undefined (RST20)
   374                          DEFC    RST_28      =       UFERR           ; User Function undefined (RST28)
   375                          DEFC    RST_30      =       UFERR           ; User Function undefined (RST30)
   376                          DEFC    INT_INT     =       acia_int        ; ACIA interrupt
   377                          DEFC    INT_NMI     =       NULL_NMI        ; RETN
   378                          
   379                          ;==============================================================================
