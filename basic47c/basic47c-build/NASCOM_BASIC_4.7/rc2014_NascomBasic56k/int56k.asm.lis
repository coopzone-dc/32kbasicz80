   343                          ; STRINGS
   344                          ;
   345                          SECTION init_strings                ; ORG $01F0
   346                          
   347                          .SIGNON1
   348  0000  0d0a                      DEFM    CR,LF
   349  0002  2007200330808112          DEFM    "RC2014 - MS Basic Loader",CR,LF
              0080200581612f20  
              00002020ff3f0120  
              0d0a              
   350  001c  0120382c263ff02c          DEFM    "z88dk - feilipu",CR,LF,0
              db00ff0120702d0d  
              0a00              
   351                          
