    13                          ;
    14                          ; DEFINES SECTION
    15                          ;
    16                          
    17                          DEFC    ROMSTOP         =   $1FFF       ; Top of ROM
    18                          
    19                          DEFC    RAM_56_START    =   $2000       ; Bottom of 56k RAM
    20                          DEFC    RAM_48_START    =   $4000       ; Bottom of 48k RAM
    21                          DEFC    RAM_32_START    =   $8000       ; Bottom of 32k RAM
    22                          
    23                          DEFC    RAMSTART        =   RAM_56_START
    24                          
    25                          ; Top of BASIC line input buffer (CURPOS WRKSPC+0ABH)
    26                          ; so it is "free ram" when BASIC resets
    27                          ; set BASIC Work space WRKSPC $8000, in RAM
    28                          
    29                          DEFC    WRKSPC      =   RAMSTART+$0200  ; set BASIC Work space WRKSPC
    30                                                                  ; beyond the end of ACIA stuff
    31                          
    32                          DEFC    TEMPSTACK   =   WRKSPC+$0A2     ; Top of BASIC line input buffer
    33                                                                  ; (CURPOS = WRKSPC+0ABH)
    34                                                                  ; so it is "free ram" when BASIC resets
    35                          
